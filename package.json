{
  "name": "recordpov",
  "version": "0.1.0",
  "private": true,
  "description": "RecordPOV \u2014 native video reactions, POV recording and editing for iOS and Android",
  "scripts": {
    "build:auth": "npm --prefix auth run build",
    "test:auth": "npm --prefix auth test",
    "typecheck:auth": "npm --prefix auth run typecheck",
    "dev:media": "npm --prefix server run dev",
    "test:media": "npm --prefix server test",
    "typecheck:media": "npm --prefix server run typecheck",
    "ios": "python3 scripts/ios.py run",
    "build:ios": "python3 scripts/ios.py build",
    "test:ios": "python3 scripts/ios.py test",
    "build:android": "python3 scripts/android.py build",
    "test:android": "python3 scripts/android.py test"
  }
}
