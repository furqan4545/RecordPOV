HOST=127.0.0.1
PORT=8789
BETTER_AUTH_URL=https://api.recordpov.app
# Generate on the server: openssl rand -base64 48. Never put this in an app.
BETTER_AUTH_SECRET=
AUTH_DATABASE_PATH=./data/auth.sqlite
# Exact immediate reverse-proxy addresses only; never a subnet or wildcard.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Google Cloud: one Web/server OAuth client ID shared by both native apps.
AUTH_GOOGLE_SERVER_CLIENT_ID=
AUTH_GOOGLE_IOS_CLIENT_ID=
# Native Apple identity-token audience: the provisioned iOS bundle identifier.
AUTH_APPLE_BUNDLE_ID=
# Required with the bundle ID: enables code exchange and deletion revocation.
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY_FILE=
# Additional Apple Android browser credentials + verified App Link:
AUTH_APPLE_SERVICES_ID=
AUTH_ANDROID_CALLBACK_URL=
