PUBLIC_BASE_URL=https://api.recordpov.app
# Existing host proxy: compose.yaml. Free 80/443: compose.yaml:compose.caddy.yaml
COMPOSE_FILE=compose.yaml
HOST_PORT=8787
IMAGE_TAG=local
YTDLP_VERSION=2026.10.26
YOUTUBE_TIMEOUT_SECONDS=600
RESOLVER_MEMORY_LIMIT=1536m
RESOLVER_CPUS=1.5
# Confirm this dedicated subnet does not overlap any existing network on Hetzner.
# Keep all four network values consistent if changing them.
RECORDPOV_SUBNET=172.30.83.0/29
RECORDPOV_GATEWAY=172.30.83.1
RECORDPOV_ADDRESS=172.30.83.2
RECORDPOV_CADDY_ADDRESS=172.30.83.3
RECORDPOV_BRIDGE=br-recordpov
