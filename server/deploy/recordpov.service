# Linux/Hetzner only. This is not a Mac service or LaunchAgent.
[Unit]
Description=RecordPOV temporary public-video resolver
Requires=docker.service
BindsTo=docker.service
PartOf=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/recordpov/deploy
EnvironmentFile=-/opt/recordpov/deploy/.env
ExecStartPre=/opt/recordpov/deploy/egress-firewall.sh apply
ExecStart=/usr/bin/docker compose --project-name recordpov up --no-build --abort-on-container-exit --exit-code-from resolver
ExecStop=/usr/bin/docker compose --project-name recordpov down --timeout 10
Restart=always
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
