# Local development only. Use your computer's LAN address on a physical phone.
HOST=127.0.0.1
PORT=8787
# Set when a reverse proxy or physical device needs a different file URL origin.
# PUBLIC_BASE_URL=https://media.example.com
# Required before exposing the API outside your trusted development network.
# API_TOKEN=replace-with-a-long-random-token
# Optional comma-separated web origins. Native clients do not need CORS.
# CORS_ORIGINS=http://localhost:3000
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_DURATION_SECONDS=3600
MAX_MEDIA_BYTES=2147483648
RESOLVE_TIMEOUT_SECONDS=180
CACHE_TTL_SECONDS=86400
MAX_CACHE_BYTES=8589934592
MAX_CONCURRENT_DOWNLOADS=2
MAX_QUEUED_DOWNLOADS=8
